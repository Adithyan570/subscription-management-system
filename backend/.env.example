# Copy this file to  backend/.env  (same folder as seed.py) and edit. It is loaded automatically.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
FRONTEND_URL=http://localhost:5173
BILLING_INTERVAL_MINUTES=60
APP_NAME=Subscription Manager

# ---------- Email (password reset + invoices) ----------
# Leave SMTP_HOST empty = dev mode: emails are printed in the backend console and saved in backend/outbox/.

# Option A: Gmail (real delivery). Needs 2-Step Verification on, then create an "App password":
#   https://myaccount.google.com/apppasswords   (use that 16-character code, NOT your normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM=yourname@gmail.com

# Option B: any provider (Outlook: smtp.office365.com:587, Brevo: smtp-relay.brevo.com:587, SendGrid: smtp.sendgrid.net:587 ...)
# Option C: local test server (python dev_mail_server.py), nothing leaves your computer:
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURITY=none
